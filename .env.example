# SSO Auth Backend
#
# Copy to .env and fill in values.

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=sso_auth

# --- Access-token signing (see docs/ROLLOUT.md) ---
# RS256 key pair; generate with: python -m scripts.generate_signing_key
# (required in production; in development a key is created under .keys/)
JWT_SIGNING_ALG=RS256
JWT_PRIVATE_KEY_B64=
JWT_ACTIVE_KID=
# "kid:<b64 public pem>,..." — old keys kept published after a rotation
JWT_PREVIOUS_PUBLIC_KEYS=
# Legacy shared secret: only needed while JWT_SIGNING_ALG=HS256 (rollout)
JWT_SECRET=
# Public URL of this API (OIDC issuer); production: https://auth.karanparmar.in/api/auth
JWT_ISSUER=http://localhost:8000/api/auth
# Audience of first-party session tokens; production: karanparmar-apps (rollout step 3)
JWT_AUDIENCE=

ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7
SHORT_SESSION_HOURS=24
REFRESH_REUSE_GRACE_SECONDS=30
ENVIRONMENT=development
COOKIE_DOMAIN=

AUTH_FRONTEND_URL=http://localhost:5173

PASSWORD_MIN_LENGTH=8
REQUIRE_EMAIL_VERIFICATION=true

# Brute-force protection
# per (email, IP)
LOGIN_MAX_FAILURES_PER_EMAIL=5
# per account across all IPs
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=50
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_FAILURE_WINDOW_MINUTES=15
PASSWORD_CHECK_MAX_FAILURES=5
SIGNUP_MAX_PER_IP_PER_HOUR=10
# Reverse proxies in front of the API that append to X-Forwarded-For (Caddy = 1)
TRUSTED_PROXY_HOPS=1

AUDIT_RETENTION_DAYS=365
NEW_DEVICE_ALERTS=true
MAX_FORGOT_PASSWORD_PER_DAY=3
MAX_CHANGE_PASSWORD_PER_DAY=3
MAX_EMAILS_PER_TOKEN=3
MAX_EMAIL_CHANGE_PER_DAY=1
MAX_VERIFY_EMAIL_SENDS_PER_DAY=3

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Auth SSO

OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
OWNER_NAME=Owner

# APScheduler — expired token cleanup once at midnight
TOKEN_CLEANUP_ENABLED=true
TOKEN_CLEANUP_HOUR=0
TOKEN_CLEANUP_TIMEZONE=Asia/Kolkata

# Optional JSON list. Default: production origins only when ENVIRONMENT=production,
# plus localhost origins otherwise.
# CORS_ORIGINS=["http://localhost:5173","https://auth.karanparmar.in"]
#
# Post-login return URLs (?next= on the SSO frontend) are allowlisted on the
# frontend via VITE_RETURN_ORIGINS. That list must match CORS_ORIGINS (same
# app origins: portfolio :5174, family_os, production hosts, etc.).
